# Local development, when Postgres runs on localhost.
DATABASE_URL=postgres://opaque:change-me@localhost:5432/opaque

# Docker Compose uses these to build DATABASE_URL for the app container.
POSTGRES_DB=opaque
POSTGRES_USER=opaque
POSTGRES_PASSWORD=change-me

# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Optional GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Metrics retention for server_metric_samples
METRICS_RETENTION_DAYS=7

# Optional for local mock/server agents
OPAQUE_URL=http://localhost:3000
SERVER_ID=copied-dashboard-agent-id
SERVER_AGENT_TOKEN=copied-agent-token
OPAQUE_INTERVAL_SECONDS=5
