{
  "name": "opaque-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-webstorage next dev",
    "build": "NODE_OPTIONS=--no-experimental-webstorage next build",
    "start": "NODE_OPTIONS=--no-experimental-webstorage next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:contract": "node --test test/contract/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "db:ensure": "node scripts/ensure-database.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:upgrade": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/upgrade-dashboard-data.ts",
    "db:validate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/validate-dashboard-data.ts",
    "metrics:retention": "node scripts/metrics-retention.mjs",
    "mock:server-agent": "node scripts/mock-server-agent.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@tabler/icons-react": "^3.34.0",
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "next": "15.3.4",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.0.0",
    "simple-icons": "^16.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.16",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
